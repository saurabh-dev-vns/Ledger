<%- include('partials/header') %>
<div class="page-head"><p class="eyebrow">Transfer</p><h1>Move money</h1><p class="sub">Transfer money between any two accounts. Your total stays unchanged.</p></div><div class="grid-2"><div class="card"><h2>Transfer</h2><form method="POST" action="/swap-balance" class="form"><input type="hidden" name="csrf_token" value="<%=csrfToken%>"><label>From<select name="from_account_id" id="fromAccount" required><% accounts.forEach(a=>{ %><option value="<%=a.id%>"><%=a.name%> — ₹<%=money(a.balance)%></option><% }) %></select></label><label>To<select name="to_account_id" id="toAccount" required><% accounts.forEach((a,i)=>{ %><option value="<%=a.id%>" <%=i===1?'selected':''%>><%=a.name%> — ₹<%=money(a.balance)%></option><% }) %></select></label><label>Amount (₹)<input type="number" name="amount" step="0.01" min="0.01" required></label><label>Note <span class="optional">optional</span><input name="note" maxlength="500" placeholder="e.g. Gave cash, received UPI"></label><button class="btn btn-primary btn-block">Transfer money</button></form></div><div class="card"><h2>Accounts</h2><% accounts.forEach(a=>{ %><div class="balance-row"><span><%=a.name%></span><span class="balance-figure">₹<%=money(a.balance)%></span></div><% }) %></div></div><script>document.getElementById('fromAccount').addEventListener('change',()=>{const f=document.getElementById('fromAccount'),t=document.getElementById('toAccount');if(f.value===t.value&&t.options.length>1)t.selectedIndex=f.selectedIndex===0?1:0;});</script><%- include('partials/footer') %>
