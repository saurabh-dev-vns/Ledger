<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %> · Ledger</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a href="/dashboard" class="brand">Ledger<span class="brand-dot">.</span></a>
    <nav class="topnav">
      <a href="/dashboard" class="<%= pageTitle === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/expenses" class="<%= pageTitle === 'All expenses' ? 'active' : '' %>">All expenses</a>
      <a href="/add-expense" class="<%= pageTitle === 'Add expense' ? 'active' : '' %>">Add expense</a>
      <a href="/add-balance" class="<%= pageTitle === 'Add balance' ? 'active' : '' %>">Add balance</a>
    </nav>
    <div class="topbar-user">
      <span><%= currentUser.name %></span>
      <form method="POST" action="/logout" style="display:inline">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button type="submit" class="logout-link">Sign out</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="page">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
<% } %>
