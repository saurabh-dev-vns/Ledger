<%- include('partials/header') %>
<div class="page-head">
  <p class="eyebrow">Spending</p>
  <h1>Add expense</h1>
  <p class="sub">Logged against whichever wallet you pay from — balance updates the moment you save.</p>
</div>

<div class="grid-2">
  <div class="card">
    <h2>New entry</h2>
    <form method="POST" action="/add-expense" class="form">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <label>Amount (₹)
        <input type="number" name="amount" step="0.01" min="0.01" required autofocus>
      </label>
      <label>Notes <span class="optional">optional</span>
        <input type="text" name="notes" placeholder="e.g. Groceries at the market">
      </label>
      <div class="form-row">
        <label>Payment method
          <select name="payment_method" required>
            <option value="cash">Cash</option>
            <option value="online">Online</option>
          </select>
        </label>
        <label>Category
          <select name="category" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <label>Date
        <input type="date" name="spent_on" value="<%= today %>" required>
      </label>
      <button type="submit" class="btn btn-primary btn-block">Save expense</button>
    </form>
  </div>

  <div class="card balance-summary">
    <h2>Available to spend</h2>
    <div class="balance-row">
      <span class="balance-label">Cash</span>
      <span class="balance-figure">₹<%= money(wallet.cash_balance) %></span>
    </div>
    <div class="balance-row">
      <span class="balance-label">Online</span>
      <span class="balance-figure">₹<%= money(wallet.online_balance) %></span>
    </div>
    <p class="hint">Expenses are deducted from the wallet you choose as payment method. If a wallet runs short, add balance first.</p>
  </div>
</div>
<%- include('partials/footer') %>
