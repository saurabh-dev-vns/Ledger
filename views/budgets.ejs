<%- include('partials/header') %>

<div class="page-head">
    <p class="eyebrow">Planning</p>
    <h1>Monthly budgets</h1>
    <p class="sub">
        Set category limits and see how much you've used.
    </p>
</div>

<div class="card budget-card">
    <form method="GET" action="/budgets" class="filter-form">
        <label>
            Month
            <input
                type="month"
                name="month"
                value="<%= month %>"
            >
        </label>

        <button class="btn btn-secondary">
            View
        </button>
    </form>
</div>

<div class="grid-2">

    <div class="card">
        <h2>Add / update budget</h2>

        <form method="POST" action="/budgets" class="form">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >

            <label>
                Category
                <select name="category">
                    <% categories.forEach(c=>{ %>
                        <option>
                            <%= c %>
                        </option>
                    <% }) %>
                </select>
            </label>

            <label>
                Month
                <input
                    type="month"
                    name="month"
                    value="<%= month %>"
                    required
                >
            </label>

            <label>
                Budget (₹)
                <input
                    type="number"
                    name="amount"
                    min="0.01"
                    step="0.01"
                    required
                >
            </label>

            <button class="btn btn-primary">
                Save budget
            </button>
        </form>
    </div>

    <div class="card">
        <h2><%= month %></h2>

        <% if(!budgets.length){ %>
            <p class="empty">
                No budgets set for this month.
            </p>
        <% } %>

        <div class="budget-list">
            <% budgets.forEach(b=>{ const pct=Math.min(100,Math.round(b.spent/b.amount*100)); %>

                <div class="budget-item">
                    <div class="bar-item-head">
                        <span>
                            <%= b.category %>
                        </span>

                        <span>
                            ₹<%= money(b.spent) %> / ₹<%= money(b.amount) %>
                        </span>
                    </div>

                    <div class="bar-track">
                        <div
                            class="bar-fill <%= pct>=100?'over':'' %>"
                            style="width:<%= pct %>%"
                        >
                        </div>
                    </div>

                    <div class="budget-foot">
                        <span>
                            <%= pct %>% used
                        </span>

                        <form
                            method="POST"
                            action="/budgets/<%= b.id %>/delete"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                value="<%= csrfToken %>"
                            >

                            <input
                                type="hidden"
                                name="month"
                                value="<%= month %>"
                            >

                            <button class="btn-link-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>

            <% }) %>
        </div>
    </div>

</div>

<%- include('partials/footer') %>