<%- include('partials/header') %>

<div class="auth-wrap">

    <div class="auth-card">
        <p class="auth-eyebrow">
            Password reset
        </p>

        <h1>
            Enter your code
        </h1>

        <p class="auth-sub">
            We sent a 6-digit code to your email if an account exists for it. Enter it below along with your new password. Codes expire after 10 minutes.
        </p>

        <form method="POST" action="/reset-password" class="form">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >

            <label>
                Email
                <input
                    type="email"
                    name="email"
                    value="<%= email %>"
                    required
                    <% if (!email) { %>autofocus<% } %>
                >
            </label>

            <label>
                6-digit code
                <input
                    type="text"
                    name="otp"
                    inputmode="numeric"
                    pattern="\d{6}"
                    maxlength="6"
                    autocomplete="one-time-code"
                    placeholder="123456"
                    required
                    <% if (email) { %>autofocus<% } %>
                >
            </label>

            <label>
                New password
                <input
                    type="password"
                    name="new_password"
                    required
                    minlength="6"
                    autocomplete="new-password"
                >
            </label>

            <label>
                Confirm new password
                <input
                    type="password"
                    name="confirm_password"
                    required
                    minlength="6"
                    autocomplete="new-password"
                >
            </label>

            <button
                type="submit"
                class="btn btn-primary btn-block"
            >
                Reset password
            </button>
        </form>

        <form method="POST" action="/forgot-password" class="auth-resend">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >
            <input
                type="hidden"
                name="email"
                value="<%= email %>"
            >

            <button type="submit" class="link-btn">
                Didn't get a code? Send another
            </button>
        </form>

        <p class="auth-switch">
            <a href="/login">
                Back to sign in
            </a>
        </p>
    </div>

</div>

<%- include('partials/footer') %>
