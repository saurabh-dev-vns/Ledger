<%- include('partials/header') %>

<div class="page-head">
    <p class="eyebrow">People</p>
    <h1>Money owed</h1>
    <p class="sub">
        Track money others owe you and money you owe them.
    </p>
</div>

<div class="grid-2">

    <div class="card">
        <h2>Add record</h2>

        <form method="POST" action="/loans" class="form">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >

            <label>
                Person
                <input
                    name="person"
                    required
                    placeholder="e.g. Rahul"
                >
            </label>

            <label>
                Direction
                <select name="direction">
                    <option value="owed_to_me">
                        They owe me
                    </option>

                    <option value="i_owe">
                        I owe them
                    </option>
                </select>
            </label>

            <label>
                Amount (₹)
                <input
                    type="number"
                    name="amount"
                    step="0.01"
                    min="0.01"
                    required
                >
            </label>

            <label>
                Note
                <input
                    name="note"
                    placeholder="Optional"
                >
            </label>

            <button class="btn btn-primary">
                Save
            </button>
        </form>
    </div>

    <div class="card">
        <h2>Open balances</h2>

        <% if(!loans.length){ %>
            <p class="empty">
                Nothing owed right now.
            </p>
        <% } %>

        <div class="loan-list">
            <% loans.forEach(l=>{ %>

                <div class="loan-item">
                    <div>
                        <strong>
                            <%= l.person %>
                        </strong>

                        <small>
                            <%= l.direction==='owed_to_me'?'They owe you':'You owe them' %>
                        </small>
                    </div>

                    <strong>
                        ₹<%= money(l.remaining_amount) %>
                    </strong>

                    <% if(l.remaining_amount>0){ %>
                        <form
                            method="POST"
                            action="/loans/<%= l.id %>/repay"
                            class="inline-form"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                value="<%= csrfToken %>"
                            >

                            <input
                                type="number"
                                name="amount"
                                max="<%= l.remaining_amount %>"
                                step="0.01"
                                min="0.01"
                                placeholder="Repay"
                                required
                            >

                            <button class="btn btn-secondary">
                                Record
                            </button>
                        </form>
                    <% } %>
                </div>

            <% }) %>
        </div>
    </div>

</div>

<%- include('partials/footer') %>