<%- include('partials/header') %>

<div class="auth-wrap">

    <div class="auth-card">
        <p class="auth-eyebrow">
            Password reset &rsaquo; Step 3 of 3
        </p>

        <h1>
            Set new password
        </h1>

        <p class="auth-sub">
            Your code was verified. Choose a new password for your account.
        </p>

        <form method="POST" action="/new-password" class="form">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

            <label>
                New password
                <input
                    type="password"
                    name="new_password"
                    required
                    minlength="6"
                    autocomplete="new-password"
                    autofocus
                >
            </label>

            <label>
                Confirm new password
                <input
                    type="password"
                    name="confirm_password"
                    required
                    minlength="6"
                    autocomplete="new-password"
                >
            </label>

            <button type="submit" class="btn btn-primary btn-block">
                Update password
            </button>
        </form>

        <p class="auth-switch">
            <a href="/login">Back to sign in</a>
        </p>
    </div>

</div>

<%- include('partials/footer') %>

