<%- include('partials/header') %>

<div class="page-head">
    <p class="eyebrow">Money</p>
    <h1>Accounts</h1>
    <p class="sub">
        Keep cash, UPI, bank accounts, cards and EMIs separate.
    </p>
</div>

<div class="grid-2">

    <div class="card">
        <h2>Add account</h2>

        <form method="POST" action="/accounts" class="form" id="add-account-form">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >

            <label>
                Name
                <input
                    name="name"
                    required
                    placeholder="e.g. HDFC Bank"
                >
            </label>

            <label>
                Type
                <select name="type" id="account-type">
                    <% accountTypes.forEach(t=>{ %>
                        <option value="<%= t %>">
                            <%= accountTypeLabel(t) %>
                        </option>
                    <% }) %>
                </select>
            </label>

            <div id="savings-fields" style="display:none">
                <label>
                    Cash in Savings (₹)
                    <input type="number" name="cash_opening" step="0.01" min="0" value="0">
                </label>

                <label>
                    Bank in Savings (₹)
                    <input type="number" name="bank_opening" step="0.01" min="0" value="0">
                </label>

                <p class="hint">
                    You can only have one Savings account. It keeps your cash
                    and bank savings together and shows how much is in each.
                </p>
            </div>

            <label id="opening-balance-field">
                Opening balance
                <input
                    type="number"
                    name="balance"
                    step="0.01"
                    min="0"
                    value="0"
                >
            </label>

            <label id="credit-limit-field" style="display:none">
                Credit limit (₹)
                <span class="optional">the card/EMI's total limit</span>
                <input
                    type="number"
                    name="credit_limit"
                    step="0.01"
                    min="0.01"
                    placeholder="e.g. 10000"
                >
            </label>

            <button class="btn btn-primary btn-block">
                Create account
            </button>
        </form>

        <script>
            (() => {
                const typeSelect = document.getElementById('account-type');
                const balanceField = document.getElementById('opening-balance-field');
                const limitField = document.getElementById('credit-limit-field');
                const limitInput = limitField.querySelector('input');
                const savingsFields = document.getElementById('savings-fields');
                const nameInput = document.querySelector('#add-account-form input[name="name"]');
                const creditTypes = ['credit', 'emi'];

                const sync = () => {
                    const isCredit = creditTypes.includes(typeSelect.value);
                    const isSavings = typeSelect.value === 'savings';
                    savingsFields.style.display = isSavings ? '' : 'none';
                    savingsFields.querySelectorAll('input').forEach((i) => { i.disabled = !isSavings; });
                    if (isSavings && !nameInput.value) nameInput.value = 'Savings';
                    balanceField.style.display = (isCredit || isSavings) ? 'none' : '';
                    limitField.style.display = isCredit ? '' : 'none';
                    limitInput.required = isCredit;
                };

                typeSelect.addEventListener('change', sync);
                sync();
            })();
        </script>
    </div>

    <div class="card">
        <h2>Your accounts</h2>

        <div class="account-list">
            <% accounts.forEach(a=>{ %>
                <% const credit = isCreditType(a.type) && a.credit_limit !== null; %>
                <% const savings = a.type === 'savings'; %>
                <% const used = credit ? a.credit_limit - a.balance : 0; %>

                <div class="account-item <%= savings ? 'account-item-savings' : '' %>">
                    <div>
                        <strong><%= a.name %></strong>
                        <small><%= accountTypeLabel(a.type) %></small>

                        <% if (savings) { %>
                            <div class="split-chips">
                                <span class="chip chip-cash">Cash ₹<%= money(a.cash_part) %></span>
                                <span class="chip chip-bank">Bank ₹<%= money(a.bank_part) %></span>
                            </div>
                        <% } %>

                        <% if (credit) { %>
                            <small>
                                Used ₹<%= money(used) %> of ₹<%= money(a.credit_limit) %> limit
                            </small>
                        <% } %>
                    </div>

                    <strong>
                        <% if (credit) { %>
                            ₹<%= money(a.balance) %> available
                        <% } else { %>
                            ₹<%= money(a.balance) %>
                        <% } %>
                    </strong>

                    <form
                        method="POST"
                        action="/accounts/<%= a.id %>/add"
                        class="inline-form"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            value="<%= csrfToken %>"
                        >

                        <% if (savings) { %>
                            <select name="part" required aria-label="Add to Cash or Bank">
                                <option value="cash">Cash</option>
                                <option value="bank">Bank</option>
                            </select>
                        <% } %>

                        <input
                            type="number"
                            name="amount"
                            step="0.01"
                            min="0.01"
                            placeholder="<%= credit ? 'Repay ₹' : 'Add ₹' %>"
                            required
                        >

                        <button class="btn btn-secondary">
                            <%= credit ? 'Repay' : 'Add' %>
                        </button>
                    </form>

                    <% if (savings) { %>
                        <form
                            method="POST"
                            action="/accounts/<%= a.id %>/move"
                            class="inline-form move-form"
                        >
                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

                            <select name="from" required aria-label="Direction">
                                <option value="cash">Cash → Bank</option>
                                <option value="bank">Bank → Cash</option>
                            </select>

                            <input
                                type="number"
                                name="amount"
                                step="0.01"
                                min="0.01"
                                placeholder="Move ₹"
                                required
                            >

                            <button class="btn btn-secondary">Move</button>
                        </form>
                    <% } %>
                </div>
            <% }) %>
        </div>

        <p class="hint">
            Savings keeps cash and bank money together. “Add” puts money
            into the part you pick; “Move” shifts money between Cash and
            Bank without changing your total.
        </p>

        <p class="hint">
            For Credit Card and EMI accounts, spending reduces the
            available amount and repaying restores it — capped at the
            card's limit — instead of changing real cash.
        </p>
    </div>

</div>

<%- include('partials/footer') %>
