<%- include('partials/header') %>

<div class="auth-wrap">

    <div class="auth-card">
        <p class="auth-eyebrow">
            Password reset
        </p>

        <h1>
            Forgot your password?
        </h1>

        <p class="auth-sub">
            Enter the email on your account and we'll send you a 6-digit code to reset it.
        </p>

        <form method="POST" action="/forgot-password" class="form">
            <input
                type="hidden"
                name="csrf_token"
                value="<%= csrfToken %>"
            >

            <label>
                Email
                <input
                    type="email"
                    name="email"
                    required
                    autofocus
                >
            </label>

            <button
                type="submit"
                class="btn btn-primary btn-block"
            >
                Send reset code
            </button>
        </form>

        <p class="auth-switch">
            Remembered it?
            <a href="/login">
                Back to sign in
            </a>
        </p>
    </div>

</div>

<%- include('partials/footer') %>
