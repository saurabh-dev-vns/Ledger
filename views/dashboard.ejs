<%- include('partials/header') %>
<div class="page-head">
  <p class="eyebrow">Overview</p>
  <h1>Welcome back, <%= currentUser.name %></h1>
  <p class="sub">Here's where things stand right now.</p>
</div>

<div class="ledger-summary">
  <div class="ledger-stitch"></div>
  <div class="ledger-summary-inner">
    <div class="ledger-total">
      <span class="ledger-total-label">Total balance</span>
      <span class="ledger-total-figure">₹<%= money(total) %></span>
    </div>
    <div class="ledger-split">
      <div class="ledger-split-item">
        <span class="dot dot-cash"></span> Cash
        <strong>₹<%= money(wallet.cash_balance) %></strong>
      </div>
      <div class="ledger-split-item">
        <span class="dot dot-online"></span> Online
        <strong>₹<%= money(wallet.online_balance) %></strong>
      </div>
      <div class="ledger-split-item">
        <span class="dot dot-spent"></span> Spent this month
        <strong>₹<%= money(monthTotal) %></strong>
      </div>
    </div>
    <div class="ledger-actions">
      <a href="/add-balance" class="btn btn-secondary">Add balance</a>
      <a href="/add-expense" class="btn btn-primary">Add expense</a>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head">
      <h2>Recent expenses</h2>
      <a href="/expenses" class="link-more">View all →</a>
    </div>
    <% if (!recent.length) { %>
      <p class="empty">Nothing logged yet. Your first entry will show up here.</p>
    <% } else { %>
      <table class="ledger-table">
        <tbody>
        <% recent.forEach(row => { %>
          <tr>
            <td class="col-date"><%= formatDate(row.spent_on) %></td>
            <td>
              <span class="cat-tag"><%= row.category %></span>
              <% if (row.notes) { %><div class="row-note"><%= row.notes %></div><% } %>
            </td>
            <td class="col-method"><%= row.payment_method[0].toUpperCase() + row.payment_method.slice(1) %></td>
            <td class="col-amount">₹<%= money(row.amount) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>This month by category</h2>
    <% if (!byCategory.length) { %>
      <p class="empty">No spending recorded this month yet.</p>
    <% } else { %>
      <div class="bar-list">
        <% byCategory.forEach(row => {
             const pct = maxCategory > 0 ? Math.round((row.total / maxCategory) * 100) : 0; %>
          <div class="bar-item">
            <div class="bar-item-head">
              <span><%= row.category %></span>
              <span>₹<%= money(row.total) %></span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: <%= pct %>%"></div></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
