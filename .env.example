# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ledger

# Render will provide DATABASE_URL for your PostgreSQL database.
DATABASE_URL=

PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# Used to email OTP codes for "forgot password" (https://resend.com).
# Optional in development — if left blank, the OTP is logged to the
# console instead of emailed, so the flow can still be tested locally.
# Required in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ledger <onboarding@resend.dev>"
